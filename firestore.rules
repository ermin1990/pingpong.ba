rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['org_admin', 'super_admin'];
    }

    function ownsCompetitionEntity(entityId) {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/competitions/$(entityId))
          && get(/databases/$(database)/documents/competitions/$(entityId)).data.ownerUid == request.auth.uid)
        ||
        (exists(/databases/$(database)/documents/amater_league_tournaments/$(entityId))
          && get(/databases/$(database)/documents/amater_league_tournaments/$(entityId)).data.ownerUid == request.auth.uid)
        ||
        (exists(/databases/$(database)/documents/amater_leagues/$(entityId))
          && get(/databases/$(database)/documents/amater_leagues/$(entityId)).data.ownerUid == request.auth.uid)
      );
    }

    // Users collection: users can read/update their own profile; super_admin can manage all users
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
      allow create: if request.auth != null; // created by server/app on first sign-in
      allow update: if request.auth != null && (request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
      allow delete: if false; // prevent deletes via client (use server tools)
    }

    // Competitions: public read; create/update/delete only for whitelisted org_admins or super_admin
    match /competitions/{compId} {
      allow read: if true;

      allow create: if request.auth != null
        && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['org_admin', 'super_admin'])
        // subscriptionExpiry must be in the future (if set)
        && (
          !('subscriptionExpiry' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) 
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.subscriptionExpiry > request.time
        );

      // Updates are allowed for owners and super_admins, but deletes are restricted
      // in production to super_admin only (prevents accidental removals by owners).
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
      // Disallow client-side deletes for regular users. Only super_admins may delete via the client.
      // NOTE: Admin SDK (server) bypasses security rules and can still delete documents when needed.
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';

      // Competition subcollections (categories, manualOrders, etc.)
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/competitions/$(compId)).data.ownerUid == request.auth.uid
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        );
      }
    }

    // Amater Leagues collection (isolated collection)
    match /amater_leagues/{leagueId} {
      allow read: if true;
      allow create: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['org_admin', 'super_admin']);
      allow update: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
      allow delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';

      match /categories/{catId} {
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/amater_leagues/$(leagueId)).data.ownerUid == request.auth.uid 
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
        );
      }
    }

    // Amater League Tournaments (the monthly events)
    match /amater_league_tournaments/{tourneyId} {
      allow read: if true;
      allow create: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['org_admin', 'super_admin']);
      allow update, delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );

      // Fix for subcollections (categories, matches, etc.)
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
          || get(/databases/$(database)/documents/amater_league_tournaments/$(tourneyId)).data.ownerUid == request.auth.uid
        );
      }
    }

    // Players: similar ownership rules
    match /players/{playerId} {
      allow read: if true;
      allow create: if request.auth != null && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['org_admin', 'super_admin']);
      allow update, delete: if request.auth != null && (
        resource.data.ownerUid == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin'
      );
    }

    // Matches: writable by owners or admins OR assigned referees
    match /matches/{matchId} {
      allow read: if true;
      allow create: if request.auth != null && (
        isAdmin()
        || request.resource.data.ownerUid == request.auth.uid
        || (request.resource.data.competitionId != null && ownsCompetitionEntity(request.resource.data.competitionId))
      );
      allow delete: if request.auth != null && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || (resource.data.competitionId != null && ownsCompetitionEntity(resource.data.competitionId))
      );
      allow update: if request.auth != null && (
        isAdmin()
        || resource.data.ownerUid == request.auth.uid
        || (resource.data.competitionId != null && ownsCompetitionEntity(resource.data.competitionId))
        || (
             exists(/databases/$(database)/documents/referees/$(request.auth.uid)) 
             && get(/databases/$(database)/documents/referees/$(request.auth.uid)).data.competitionId == resource.data.competitionId
           )
      );
    }

    // Referees collection
    match /referees/{refereeId} {
      allow read: if true; 
      allow create: if request.auth != null && (
        isAdmin()
        || (request.auth.uid == refereeId && request.resource.data.currentUid == request.auth.uid)
      );
      allow update: if request.auth != null && (
        isAdmin()
        || (resource.data.currentUid == null)
        || (resource.data.currentUid == request.auth.uid)
      );
      allow delete: if request.auth != null && (
        isAdmin()
        || (resource.data.currentUid == null)
        || (resource.data.currentUid == request.auth.uid)
      );
    }

    // Access requests and whitelisted_emails
    match /access_requests/{reqId} {
      allow create: if request.auth != null;
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
      allow update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Deleted matches (recycle bin): only admins and owners can read/write
    match /deleted_matches/{docId} {
      allow read, delete: if request.auth != null && (
        isAdmin()
        || resource.data.deletedBy == request.auth.uid
        || (resource.data.competitionId != null && ownsCompetitionEntity(resource.data.competitionId))
      );
      allow create: if request.auth != null && (
        isAdmin()
        || request.resource.data.deletedBy == request.auth.uid
        || (request.resource.data.competitionId != null && ownsCompetitionEntity(request.resource.data.competitionId))
      );
      allow update: if false;
    }

    // Global settings (e.g. theme)
    match /settings/{docId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    match /whitelisted_emails/{id} {
      allow read: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
      allow create, update, delete: if request.auth != null && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin';
    }

    // Fallback: read public documents
    match /{document=**} {
      allow read: if true;
    }
  }
}

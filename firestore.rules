rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // MojTurnir.ba is a static promo hub with no admin/login - the only
    // write surface is the public contact form. Submissions are reviewed
    // directly in the Firebase console, so there's no client read path.
    match /contact_requests/{reqId} {
      allow create: if request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.email is string && request.resource.data.email.size() > 0
        && request.resource.data.status == 'pending';
      allow read, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
